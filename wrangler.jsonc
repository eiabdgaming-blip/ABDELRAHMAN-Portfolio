{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abdelrahman-portfolio-workers-preview",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_request_signal"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
  "PORTFOLIO_INDEXING_ENABLED": "0",
  "NEXT_PUBLIC_SITE_URL": "https://abdelrahman-portfolio-workers-preview.eiabdgaming.workers.dev"
},
  "secrets": {
    "required": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
      "SUPABASE_MEDIA_SECRET_KEY",
      "CLOUDINARY_CLOUD_NAME",
      "CLOUDINARY_API_KEY",
      "CLOUDINARY_API_SECRET"
    ]
  }
}
