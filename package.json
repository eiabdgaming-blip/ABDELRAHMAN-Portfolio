{
  "name": "abdelrahman-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview -- --ip 127.0.0.1",
    "check:worker": "wrangler deploy --dry-run",
    "test": "node --test tests/foundation.test.ts",
    "test:smoke": "node --test tests/routing.test.mjs",
    "test:auth": "node --test tests/admin-auth.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "test:engines": "node --test tests/engines.test.mjs",
    "capture": "node tests/capture.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3",
    "wrangler": "4.162.0"
  }
}
